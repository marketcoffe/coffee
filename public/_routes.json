{
  "version": 1,
  "include": ["/api/*"],
  "exclude": [],
  "rules": [
    { "handlers": ["static"], "pattern": "/assets/.*" },
    { "handlers": ["static"], "pattern": "/images/.*" },
    { "handlers": ["static"], "pattern": "/fonts/.*" },
