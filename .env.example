# ═══════════════════════════════════════════════════════════════════
# VARIABLES DE ENTORNO — SUPABASE ( Públicas / VITE_* )
# ═══════════════════════════════════════════════════════════════════
# Estas se inyectan en el bundle del cliente (Vite).
# SOLO contienen valores públicos (anon key, URL del proyecto).

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ═══════════════════════════════════════════════════════════════════
# WEB PUSH — VAPID (Sólo la clave pública va al cliente)
# ═══════════════════════════════════════════════════════════════════
VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY_BASE64

# ═══════════════════════════════════════════════════════════════════
# WEBHOOK DE NOTIFICACIONES (URL pública — el secret va en Cloudflare)
# ═══════════════════════════════════════════════════════════════════
VITE_PUSH_WEBHOOK_URL=https://your-domain.com/api/push-notify

# ═══════════════════════════════════════════════════════════════════
# CONFIGURACIÓN DE LA APP
# ═══════════════════════════════════════════════════════════════════
VITE_APP_NAME=Market Coffee Sweet
VITE_APP_TAGLINE=Tu tienda a domicilio
VITE_DEFAULT_THEME_COLOR=#FF6B35
VITE_APP_VERSION=2.0.0

# ═══════════════════════════════════════════════════════════════════
# SECRETOS DE SERVIDOR (NUNCA en el bundle del cliente)
# Configurar en: Cloudflare Pages → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════════════
# PUSH_WEBHOOK_SECRET=YOUR_PUSH_WEBHOOK_SECRET
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY

# ═══════════════════════════════════════════════════════════════════
# CORS — Orígenes permitidos para /api/* (separados por coma)
# ═══════════════════════════════════════════════════════════════════
ALLOWED_ORIGINS=https://your-domain.com,http://localhost:3000
